{
  "name": "reasonix-token-hud",
  "version": "1.0.2",
  "description": "Reasonix Token HUD — a DeepSeek Harness sidebar plugin for live token usage, context occupancy, per-session cost and account balance.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/fold.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beijiangwx/dsh-reasonix-token-hud.git"
  },
  "homepage": "https://github.com/beijiangwx/dsh-reasonix-token-hud#readme",
  "bugs": {
    "url": "https://github.com/beijiangwx/dsh-reasonix-token-hud/issues"
  },
  "author": "beijiangwx",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "cost",
    "sidebar",
    "reasonix",
    "balance",
    "usage",
    "hud"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
